<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/header_area_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/green_1">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:src="@drawable/halal_logo"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="7dp"
                        android:layout_marginTop="50dp"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="50dp">
                    <ImageView
                        android:id="@+id/white_logo"
                        android:layout_width="wrap_content"
                        android:layout_height="115dp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/oman_white_logo"/>
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/header_area_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/header_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:src="@drawable/bh_header_background_1"/>
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/halal_logo_2"
                    android:adjustViewBounds="true"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="50dp"/>
            </FrameLayout>
            <LinearLayout
                android:layout_width="35dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center|end"
                android:layout_marginEnd="10dp">
                <ImageView
                    android:id="@+id/menu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/green_1" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="1dp"
            android:background="@drawable/rect_1">
            <LinearLayout
                android:id="@+id/slider_1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/slider_text_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:textColor="@color/white"
                    android:fontFamily="@font/regular"
                    android:textSize="13sp"
                    android:text="@string/slider_text"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/slider_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/slider_background">
                <TextView
                    android:id="@+id/slider_text_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/black"
                    android:fontFamily="@font/regular"
                    android:textSize="13sp"
                    android:text="@string/slider_switch_text_2"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
                <ImageView
                    android:id="@+id/slider_icon_2"
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_cast"
                    app:tint="@color/black"
                    android:layout_marginEnd="5dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@color/gray">
            <LinearLayout
                android:id="@+id/home_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white">
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/home_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="25dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginEnd="15dp">
                            <TextView
                                android:id="@+id/text_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/green_1"
                                android:fontFamily="@font/regular"
                                android:textSize="20sp"
                                android:text="@string/main_text_1"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:layout_marginBottom="7dp"/>
                            <TextView
                                android:id="@+id/text_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/gray"
                                android:fontFamily="@font/regular"
                                android:textSize="14sp"
                                android:text="@string/main_text_2"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"/>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="end"
                                android:layout_marginTop="20dp">
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:paddingTop="5dp"
                                    android:paddingBottom="5dp"
                                    android:background="@drawable/round_1">
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:paddingStart="6dp"
                                        android:paddingEnd="6dp"
                                        android:paddingTop="1dp"
                                        android:paddingBottom="1dp"
                                        android:layout_marginEnd="5dp"
                                        android:background="@drawable/round_green_btn_background_2">
                                        <TextView
                                            android:id="@+id/account_number"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textColor="@color/white"
                                            android:fontFamily="@font/bold"
                                            android:textSize="20sp"
                                            android:text="20"/>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:padding="3dp"
                                        android:layout_marginStart="5dp">
                                        <TextView
                                            android:id="@+id/account_text"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textColor="@color/white"
                                            android:fontFamily="@font/medium"
                                            android:textSize="13sp"
                                            android:gravity="center"
                                            android:text="@string/account_text"/>
                                    </LinearLayout>
                                </LinearLayout>
                                <View
                                    android:layout_width="55dp"
                                    android:layout_height="2dp"
                                    android:background="@color/green_1"
                                    android:layout_marginTop="3dp"/>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="20dp">
                            <LinearLayout
                                android:id="@+id/question_area"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:paddingTop="10dp"
                                    android:paddingBottom="10dp"
                                    android:paddingStart="5dp"
                                    android:paddingEnd="5dp"
                                    android:layout_marginStart="20dp"
                                    android:layout_marginEnd="20dp"
                                    android:background="@drawable/round_2">
                                    <TextView
                                        android:id="@+id/question_btn"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/white"
                                        android:fontFamily="@font/regular"
                                        android:textSize="17sp"
                                        android:text="@string/question_btn_text"
                                        android:gravity="center"/>
                                </LinearLayout>

                                <include
                                    android:id="@+id/question_view"
                                    layout="@layout/layout_question"/>

                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/register_area"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone">
                                <include
                                    android:id="@+id/register_view"
                                    layout="@layout/layout_register" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/comment_btn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:background="@color/green_1"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/white"
                                    android:fontFamily="@font/regular"
                                    android:textSize="18sp"
                                    android:gravity="center"
                                    android:text="@string/comments"/>
                                <ImageView
                                    android:id="@+id/comment_dropdown"
                                    android:layout_width="20dp"
                                    android:layout_height="wrap_content"
                                    android:adjustViewBounds="true"
                                    android:src="@drawable/arrow_up"
                                    app:tint="@color/white"
                                    android:layout_marginStart="20dp"/>
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/comment_area"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:descendantFocusability="blocksDescendants">
                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/comment_list"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"/>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:gravity="center"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginBottom="10dp">
                                    <TextView
                                        android:id="@+id/load_more"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/white"
                                        android:fontFamily="@font/bold"
                                        android:textSize="14sp"
                                        android:gravity="center"
                                        android:text="@string/load_more"
                                        android:paddingStart="35dp"
                                        android:paddingEnd="35dp"
                                        android:paddingTop="3dp"
                                        android:paddingBottom="3dp"
                                        android:background="@drawable/round_3"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/about_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <include
                    android:id="@+id/about_view"
                    layout="@layout/layout_about_us"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/contact_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <include
                    android:id="@+id/contact_view"
                    layout="@layout/layout_contact"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/thanks_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <include
                    android:id="@+id/thanks_view"
                    layout="@layout/layout_thanks"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <com.google.android.material.navigation.NavigationView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:fitsSystemWindows="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <include
                android:id="@+id/menu_area"
                layout="@layout/layout_menu" />
        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>
</androidx.drawerlayout.widget.DrawerLayout>
